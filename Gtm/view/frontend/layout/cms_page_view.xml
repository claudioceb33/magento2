<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceContainer name="content">
            <!-- Bloque principal del dataLayer -->
            <block class="Magento\Framework\View\Element\Template"
                   name="ceb.gtm.datalayer.data.cms"
                   template="Ceb_Gtm::event/datalayer.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ceb\Gtm\ViewModel\DataLayer</argument>
                    <argument name="event_type" xsi:type="string">cms</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
