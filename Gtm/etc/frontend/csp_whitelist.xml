<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="gtm-script" type="host">https://www.googletagmanager.com</value>
                <value id="ga-script" type="host">https://www.google-analytics.com</value>
                <value id="gs-script" type="host">https://www.googleadservices.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="gtm-img" type="host">https://www.googletagmanager.com</value>
                <value id="ga-img" type="host">https://www.google-analytics.com</value>
                <value id="gs-img" type="host">https://www.googleadservices.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="gtm-css" type="host">https://www.googletagmanager.com</value>
                <value id="ga-css" type="host">https://www.google-analytics.com</value>
                <value id="gs-css" type="host">https://www.googleadservices.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="gtm-frame" type="host">https://www.googletagmanager.com</value>
                <value id="ga-frame" type="host">https://www.google-analytics.com</value>
                <value id="gs-frame" type="host">https://www.googleadservices.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
