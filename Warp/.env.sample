# Project configurations
NAMESPACE=
PROJECT=
DOCKER_PRIVATE_REGISTRY=
FRAMEWORK=m2

# Docker Compose Project Name:
COMPOSE_PROJECT_NAME=m2_demo66

# Docker configurations
COMPOSE_HTTP_TIMEOUT=300

# VERSION Configuration
WARP_VERSION=2022.07.11

# Docker Sync
USE_DOCKER_SYNC=Y


# NGINX Configuration
HTTP_BINDED_PORT=80
HTTPS_BINDED_PORT=443
HTTP_HOST_IP=172.50.10.20
VIRTUAL_HOST=local.demo66.com
NGINX_CONFIG_FILE=./.warp/docker/config/nginx/sites-enabled/local.demo66.com.conf


# Config PHP
PHP_VERSION=8.3-fpm

# Config xdebug by Console
XDEBUG_CONFIG=remote_host=172.17.0.1
PHP_IDE_CONFIG=serverName=docker

# PHP Extra Modules
PHP_EXTRA_LIBS=()

# MySQL Configuration
MYSQL_VERSION=10.6.22
MYSQL_DOCKER_IMAGE=mariadb:10.6.22
MYSQL_CONFIG_FILE=./.warp/docker/config/mysql/conf.d
DATABASE_BINDED_PORT=3310
DATABASE_ROOT_PASSWORD=HyDl0ipB
DATABASE_NAME=warp_db
DATABASE_USER=warp
DATABASE_PASSWORD=Warp2020

# Elasticsearch
ES_VERSION=2.12.0
ES_MEMORY=512m
ES_PASSWORD=XmsES_MEMORY++99

#Config Redis
REDIS_CACHE_VERSION=7.2
REDIS_CACHE_CONF=./.warp/docker/config/redis/redis.conf

REDIS_SESSION_VERSION=7.2
REDIS_SESSION_CONF=./.warp/docker/config/redis/redis.conf

REDIS_FPC_VERSION=7.2
REDIS_FPC_CONF=./.warp/docker/config/redis/redis.conf

#Config Mailhog
MAILHOG_BINDED_PORT=8010


# VARNISH Configuration
USE_VARNISH=N
VARNISH_VERSION=

# Network information
NETWORK_SUBNET=172.50.10.0/24
NETWORK_GATEWAY=172.50.10.1
NETWORK_NAME=warp_net

