<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head></head>
    <body>
        <referenceContainer name="sidebar.additional" remove="true"/>
        <move element="category.image" destination="category.view.container" before="-" />
        <move element="breadcrumbs" destination="category.view.container" before="page.main.title" />
        <move element="page.main.title" destination="category.view.container" after="-" />
        <referenceBlock name="category.products.list">
            <arguments>
                <argument name="brand_viewmodel" xsi:type="object">Ecommerce66\Brands\ViewModel\BrandData</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>