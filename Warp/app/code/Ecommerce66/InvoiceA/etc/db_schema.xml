<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote" resource="default">
        <column xsi:type="int" name="customer_tax_situation" unsigned="false" nullable="true" identity="false" comment="Customer Tax Situation"/>
        <column xsi:type="varchar" name="customer_cuit" nullable="true" length="255" comment="CUIT Number"/>
        <column xsi:type="varchar" name="customer_company" nullable="true" length="255" comment="Company Name"/>
    </table>
    <table name="sales_order" resource="default">
