<?php
/** @var \Ecommerce66\AiLlmSearch\Block\Widget $block */
/**
 * Minimal widget template. Exposes data attributes for the JS module.
 */
?>
<div id="e66-llm-search-widget"
     class="e66-llm-container e66-llm-modern"
     data-endpoint="<?= /* @noEscape */ $block->escapeHtmlAttr($block->getProxyUrl()); ?>"
     data-enabled="<?= $block->isEnabled() ? '1' : '0'; ?>"
     data-session="<?= $block->escapeHtmlAttr($block->getSessionId()); ?>"
     data-action="<?= $block->escapeHtmlAttr($block->getDefaultAction()); ?>"
     data-default-query="<?= $block->escapeHtmlAttr($block->getDefaultQuery()); ?>"
     data-view-mode="<?= $block->escapeHtmlAttr($block->getData('view_mode') ?: 'grid'); ?>"
     data-mage-init='{"Ecommerce66_AiLlmSearch/js/llmsearch":{"ctaSelector":".e66-llm-submit"}}'>

    <div class="e66-llm-inner">
        <div class="e66-llm-header-row">
            <div class="e66-llm-title"><?= /* @noEscape */  $block->escapeHtml($block->getData('title') ?: __('Curated selection')); ?></div>
        </div>

        <div class="e66-llm-description"><?= /* @noEscape */ __('Discover curated suggestions and product explanations generated by AI.'); ?></div>

        <form class="e66-llm-form" data-role="llm-form">
            <div class="e66-llm-form-row">
                <input type="text"
                       class="e66-llm-query-input"
                       data-role="llm-query"
                       value="<?= /* @noEscape */ $block->getDefaultQuery(); ?>"
                       placeholder="<?= /* @noEscape */ __('What are you looking for today?'); ?>" />
                <button type="submit" class="e66-llm-submit" data-role="llm-submit"><?= /* @noEscape */ __('Ask AI'); ?></button>
            </div>
        </form>

        <div class="e66-llm-content" aria-live="polite">
            <!-- placeholder for AI-rendered results -->
            <div class="e66-llm-grid e66-llm-placeholder">
                <div class="e66-llm-card e66-llm-empty-card">
                    <div class="e66-llm-empty-title"><?= /* @noEscape */ __('No suggestions yet'); ?></div>
                    <div class="e66-llm-empty-desc"><?= /* @noEscape */ __('Use the search box or press "Ask AI" to start.'); ?></div>
                </div>
            </div>
        </div>
    </div>
</div>
