<?xml version="1.0"?>
<!-- System config for AiCore under existing "e66" tab -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="ecommerce66_ai" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <group id="shopping" translate="label" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Shopping Assistance</label>

                <field id="copilot_endpoint" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Copilot Endpoint</label>
                    <comment>Relative path from Base URL. Default: /api/v1/copilot/search</comment>
                </field>

                <field id="seller_id" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Seller</label>
                    <source_model>Ecommerce66\AiLlmSearch\Model\Config\Source\Seller</source_model>
                    <comment>Resolved via /sellers/ endpoint using the configured client credentials.</comment>
                </field>

                <field id="copilot_timeout" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Copilot Timeout (seconds)</label>
                    <comment>Set to 0 for unlimited timeout. Applies only to Copilot requests.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>

                <field id="seller_persona" translate="label comment" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Seller Persona Prompt</label>
                    <comment><![CDATA[Optional prompt/persona text sent to the Copilot for this seller. Use the buttons below to load or update the persona via API.]]></comment>
                    <frontend_model>Ecommerce66\AiLlmSearch\Block\Adminhtml\System\Config\PersonaField</frontend_model>
                </field>
            </group>
</section>
    </system>
</config>   