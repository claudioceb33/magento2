<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <attribute name="class" value="login-otp-body"/>
        <referenceBlock name="customer_form_login">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Ecommerce66_OTPLogin::form/login.phtml</argument>
            </action>
            <arguments>
                <argument name="otp_view_model" xsi:type="object">Ecommerce66\OTPLogin\ViewModel\OTPData</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
