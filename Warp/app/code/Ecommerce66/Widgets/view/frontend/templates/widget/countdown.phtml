         background-color: <?= /* @noEscape */ $block->getData('background_color') ?>;">

    <div class="row <?= /* @noEscape */$block->getData('clock_position') ?>">

        <h2 class="title"><?= /* @noEscape */$block->getData('title') ?></h2>

        <h3 class="sub title"
            data-start="<?= /* @noEscape */$block->getData('start_subtitle') ?>"
