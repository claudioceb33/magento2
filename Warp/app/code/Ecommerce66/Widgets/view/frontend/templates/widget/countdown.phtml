            </div>
            <div class="time">
                <span class="minutes"></span>
                <span class="smalltext"><?= /* @noEscape */ __('Minutos') ?></span>
            </div>
            <div class="time">
                <span class="seconds"></span>
                <span class="smalltext"><?= /* @noEscape */ __('Segundos') ?></span>
            </div>
        </div>
    </div>
</div>

<script >
    require([
        'jquery'
    ], function($) {
        var hideProducts = <?= /* @noEscape */ $hideProducts ?>;
        var $productBlocks = $('#layered-filter-block,.toolbar-products,.products-grid,.products-list');

        /*
         * Use this to initialize:
         *   var deadline = new Date("Mon May 13 2022");
         *   initializeClock('clockdiv', deadline);
         */

        var startString = "<?= /* @noEscape */ $block->getData('event_from') ?>T<?=  /* @noEscape */ $block->getData('event_from_hour') ?>:00:00";
        var endString = "<?= /* @noEscape */ $block->getData('event_to') ?>T<?= /* @noEscape */ $block->getData('event_to_hour') ?>:00:00";

        var dateStart = new Date(startString);
        var dateEnd = new Date(endString);
        var now = new Date();

        var $event = $('.event-countdown');
        var countdownDate;
        var diffTimeStart = dateStart.getTime() - now.getTime();
        var diffTimeEnd = dateEnd.getTime() - now.getTime();
        if(diffTimeStart > 0){
            //Time to event start date
            countdownDate = startString;
            $event.removeClass('end').addClass('start');
            $event.find('.sub.title').text($event.find('.sub.title').attr('data-start'));
            eventStart(countdownDate);
            if (hideProducts) {
                $productBlocks.hide();
            }
        }else if(diffTimeEnd > 0){
            //Time to event end date
            countdownDate = endString;
            $event.removeClass('start').addClass('end');
            $event.find('.sub.title').text($event.find('.sub.title').attr('data-end'));
            eventStart(countdownDate);
        }else{
            $event.find('.sub.title').text($event.find('.sub.title').attr('data-fin'));
            $('#clockdiv').css('visibility', 'hidden');
            if (hideProducts) {
                $productBlocks.hide();
            }
        }

        function eventStart(countdownDate){
            //var deadline = new Date("Mon Jun 15 2020");
            var deadline = new Date(countdownDate);
            initializeClock('clockdiv', deadline);
        }

        function getTimeRemaining(endtime) {
            var t = Date.parse(endtime) - Date.parse(new Date());
            var seconds = Math.floor((t / 1000) % 60);
            var minutes = Math.floor((t / 1000 / 60) % 60);
            var hours = Math.floor((t / (1000 * 60 * 60)) % 24);
            var days = Math.floor(t / (1000 * 60 * 60 * 24));
            return {
                'total': t,
                'days': days,
                'hours': hours,
                'minutes': minutes,
                'seconds': seconds
            };
        }

        function initializeClock(id, endtime) {
            var clock = document.getElementById(id);
            var daysSpan = clock.querySelector('.days');
            var hoursSpan = clock.querySelector('.hours');
            var minutesSpan = clock.querySelector('.minutes');
            var secondsSpan = clock.querySelector('.seconds');

            function updateClock() {
                var t = getTimeRemaining(endtime);

                daysSpan.innerHTML = t.days;
                hoursSpan.innerHTML = ('0' + t.hours).slice(-2);
                minutesSpan.innerHTML = ('0' + t.minutes).slice(-2);
                secondsSpan.innerHTML = ('0' + t.seconds).slice(-2);

                if (t.total <= 0) {
                    clearInterval(timeinterval);
                    window.location.reload();
                }
            }

            updateClock();
            var timeinterval = setInterval(updateClock, 1000);
        }

        /**
         * Behaviour
         */
        changeImages();

        $(window).on('resize', function(){
            changeImages();
        });

        function changeImages(){
            var imgage = ($(window).width() > 799) ?
                $event.attr('data-image-desktop') : $event.attr('data-image-mobile');
            $event.css('background-image', 'url(' + imgage + ')');
        }
    });
</script>

