            data-fin="<?= /* @noEscape */$block->getData('finished_subtitle') ?>"></h3>

        <div id="clockdiv" class="clock-wrapper"
             data-start-date="<?= /* @noEscape */$block->getData('event_from') ?>"
             data-start-hour="<?= /* @noEscape */$block->getData('event_from_hour') ?>"
             data-end-date="<?= /* @noEscape */$block->getData('event_to') ?>"
             data-end-hour="<?= /* @noEscape */$block->getData('event_to_hour') ?>">
            <div class="time">
                <span class="days"></span>
                <span class="smalltext"><?= /* @noEscape */ __('Días') ?></span>
            </div>
            <div class="time">
