                    console.log('*');
                });

// Скролл
                jQuery(window).load(function(){
                    jQuery(".mcs-horizontal").mCustomScrollbar({
                        axis:"x",
                        theme:"dark-thick",
                        autoExpandScrollbar:true,
                        advanced:{autoExpandHorizontalScroll:true},
                        updateOnContentResize:true,
                        scrollbarPosition: 'outside',
                        scrollInertia: 200
                    });
                });
            });

        });
    </script>
<?php endif;?>
