                jQuery('[data-filter=".idx-1"]').click(function(e) {
                    $carousel.slick('slickUnfilter');
                    $carousel.slick('slickFilter', $('.idx-1') );

                    console.log('click 1');
                });

                jQuery('[data-filter="*"]').click(function(e) {
                    $carousel.slick('slickUnfilter');
