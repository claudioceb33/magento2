                min-height: calc((<?=  /* @noEscape */ $block->getData('font_size'); ?>px * 1.43) + 40px);
                text-align: center;
                margin: 0;
                padding: 20px 0;
            }
        </style>
        <script >
            require(['jquery',"https://cdn.jsdelivr.net/npm/animejs@3.0.1/lib/anime.min.js"], function($,anime) {

                function wrapWords (text) {
                    words = text.split(" ");
                    var spantext = "";
                    for (var i = 0; i < words.length; i++) {
                        spantext += "<span class='word-anima' style = \"opacity: 0; position: relative; top: 0px;\">" + words[i] +  " " + "</span>";
                    }
                    return spantext
                }

                function animatetext () {
                    anime({
                        targets: '#<?=  /* @noEscape */ $block->getData("animate_id"); ?> .to-animate .word-anima',
                        translateY: -30,
                        duration: <?=  /* @noEscape */ $block->getData('animate_duration'); ?>,
                        opacity: 1,
                        loop: true,
                        delay: anime.stagger(<?=  /* @noEscape */ $block->getData('animate_between'); ?>),
                    });
                }

                $(function() {
                    x =  "<?=  /* @noEscape */ $block->getData('title'); ?>";
                    xarr = wrapWords(x);
                    $('#<?=  /* @noEscape */ $block->getData("animate_id"); ?> .to-animate').append(xarr);
                    animatetext(xarr);
                });
            });
        </script>
    </div>
<?php } ?>

