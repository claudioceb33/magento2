        <style>
            #<?=  /* @noEscape */ $block->getData("animate_id"); ?>.word-container {
                background-color: <?=  /* @noEscape */ $block->getData('background_color'); ?>;
                margin: 20px 0;
            }
            #<?=  /* @noEscape */ $block->getData("animate_id"); ?>.word-container p {
