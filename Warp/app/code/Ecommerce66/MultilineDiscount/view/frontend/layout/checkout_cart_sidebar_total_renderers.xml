<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="minicart">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="minicart_content" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="custom_discount" xsi:type="array">
                                    <item name="component" xsi:type="string">Magento_Checkout/js/view/checkout/minicart/subtotal/totals</item>
                                    <item name="config" xsi:type="array">
                                        <item name="displayArea" xsi:type="string">subtotalContainer</item>
                                        <item name="template" xsi:type="string">Ecommerce66_MultilineDiscount/checkout/minicart/customdiscount</item>
                                    </item>
                                    <item name="children" xsi:type="array">
                                        <item name="customdiscount.totals" xsi:type="array">
                                            <item name="component" xsi:type="string">Ecommerce66_MultilineDiscount/js/view/checkout/summary/discount_minicart</item>
                                            <item name="config" xsi:type="array">
                                                <item name="template" xsi:type="string">Ecommerce66_MultilineDiscount/checkout/minicart/customdiscount/data</item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
