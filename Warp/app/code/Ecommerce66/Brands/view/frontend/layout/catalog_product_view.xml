<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="columns.top">
            <block name="brands_product_banner" after="messages"
                   class="Ecommerce66\Brands\Block\Brand\Product"
                   template="Ecommerce66_Brands::brand/product.phtml" />
        </referenceContainer>
        <referenceContainer name="product.info.main">
            <block name="product_brand_link" before="product.info.price"
                   class="Ecommerce66\Brands\Block\Brand\Link"
                   template="Ecommerce66_Brands::brand/link.phtml" />
        </referenceContainer>
        <referenceContainer name="page.bottom.container">
            <block class="Ecommerce66\Brands\Block\Brand\Slider" before="-"
                   template="Ecommerce66_Brands::brand/slider.phtml"
                   ifconfig="brands/settings/show_slider_in_pdp"/>
        </referenceContainer>
    </body>
</page>
