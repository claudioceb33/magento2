<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Ecommerce66\Brands\Block\Brands"
                   name="brand_brands_index"
                   template="Ecommerce66_Brands::brands.phtml"/>

            <block class="Ecommerce66\Brands\Block\Landing"
                   name="brand_landing_view"
                   template="Ecommerce66_Brands::landing.phtml"/>
        </referenceContainer>

        <referenceContainer name="sidebar.additional" remove="true"/>
    </body>
</page>


