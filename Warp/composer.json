{
    "name": "magento/project-community-edition",
    "description": "eCommerce Platform for Growth (Community Edition)",
    "type": "project",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "version": "2.4.7-p7",
    "require": {
        "cweagans/composer-patches": "^1.7",
        "ecommerce66/cart-quantity": "^1.0",
        "ecommerce66/m2-producttabs": "^1.1",
        "ecommerce66/m2-tablerate": "^1.0",
        "hexamarvel/module-flexibleform": "^1.0",
        "lillik/magento2-price-decimal": "^1.0",
        "magento/composer-dependency-version-audit-plugin": "~0.1",
        "magento/composer-root-update-plugin": "^2.0.4",
        "magento/product-community-edition": "2.4.7-p7",
        "mageplaza/module-backend-reindex": "^4.0",
        "mageplaza/module-smtp": "^4.7",
        "mageplaza/module-table-rate-shipping": "4.0.6",
        "magtools/m2-cronrun": "^0.1.2",
        "magtools/m2-spamblocker": "^0.1.4",
        "magtools/m2-trustedemail": "^0.1.3",
        "markshust/magento2-module-disabletwofactorauth": "^2.0",
        "opensearch-project/opensearch-php": "2.3.1",
        "pronko/selective-cache": "^2.1",
        "redchamps/module-clean-admin-menu": "^1.1",
        "smile/elasticsuite": "^2.11",
        "snowdog/module-menu": "^2.28",
        "swissup/pro-labels": "^1.7",
        "swissup/product-address-field-manager": "^1.6",
        "swissup/product-customer-field-manager": "^1.2",
        "swissup/seo-suite": "^1.18"
    },
    "autoload": {
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**"
        ],
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "psr-4": {
            "Magento\\Setup\\": "setup/src/Magento/Setup/"
        }
    },
    "require-dev": {
        "allure-framework/allure-phpunit": "^2",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7 || ^1.0",
        "dg/bypass-finals": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.22",
        "lusitanian/oauth": "^0.8",
        "magento/magento-coding-standard": "*",
        "magento/magento2-functional-testing-framework": "^4.7",
        "pdepend/pdepend": "^2.10",
        "phpmd/phpmd": "^2.12",
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^9.5",
        "sebastian/phpcpd": "^6.0",
        "smile/module-debug-toolbar": "^7.0",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/finder": "^6.4"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "localextensions": {
            "type": "path",
            "url": "extensions/*/*",
            "options": {
                "symlink": true
            }
        },
        "magento":{
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    },
    "extra": {
        "magento-force": "override",
        "composer-exit-on-patch-failure": false,
        "patches": {
            "magento/module-catalog-search": {
                "Fix Reindex error Full Text Search": "patches/composer/Mage.CatalogSearch.FixReindexErrorFulltext.patch"
            },
            "magento/module-sales": {
                "Fix Order status Update on comment": "patches/composer/Mage.Sale.FixOrderStatusInComments.patch"
            }

        }
    }
}
