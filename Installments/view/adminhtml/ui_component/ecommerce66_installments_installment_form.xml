<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">ceb_installments_installment_form.installment_form_data_source</item>
		</item>
		<item name="label" xsi:type="string" translate="true">Installment data</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button name="back" class="Ceb\Installments\Block\Adminhtml\Installment\Edit\BackButton"/>
			<button name="delete" class="Ceb\Installments\Block\Adminhtml\Installment\Edit\DeleteButton"/>
			<button name="save" class="Ceb\Installments\Block\Adminhtml\Installment\Edit\SaveButton"/>
			<button name="save_and_continue" class="Ceb\Installments\Block\Adminhtml\Installment\Edit\SaveAndContinueButton"/>
		</buttons>
		<namespace>ceb_installments_installment_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>ceb_installments_installment_form.installment_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="installment_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider name="installment_form_data_source" class="Ceb\Installments\Model\Installment\DataProvider">
			<settings>
				<requestFieldName>installment_id</requestFieldName>
				<primaryFieldName>installment_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>General</label>
		</settings>
		<field name="name" formElement="input" sortOrder="10">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Installment</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Name</label>
				<dataScope>name</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
		<field name="installments" formElement="input" sortOrder="20">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Installment</item>
				</item>
			</argument>
			<settings>
				<dataType>integer</dataType>
				<label translate="true">Installments</label>
				<dataScope>installments</dataScope>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
			</settings>
		</field>
		<field name="rate" formElement="input" sortOrder="30">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Installment</item>
				</item>
			</argument>
			<settings>
				<dataType>decimal</dataType>
				<label translate="true">Rate</label>
				<dataScope>rate</dataScope>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
			</settings>
		</field>
        <field name="disclaimer" formElement="input" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">Installment</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Disclaimer</label>
                <dataScope>disclaimer</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">false</rule>
                </validation>
            </settings>
        </field>
	</fieldset>
</form>
